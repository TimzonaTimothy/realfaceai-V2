# 1. Build the release app
flutter build macos --release




# 2. Install create-dmg (one-time)
brew install create-dmg

# 3. Create the DMG
create-dmg \
  --volname "RealFaceAI" \
  --volicon "assets/icon/app_icon.png" \
  --window-pos 200 120 \
  --window-size 540 380 \
  --icon-size 128 \
  --icon "RealFaceAI.app" 150 185 \
  --hide-extension "RealFaceAI.app" \
  --app-drop-link 390 185 \
  --no-internet-enable \
  "RealFaceAI-1.1.0.dmg" \
  "build/macos/Build/Products/Release/RealFaceAI.app"